"Zeige diese Hilfe und beende\n"
"\n"

#: src/CardCol.cpp:1482
msgid ""
"Valid values for GAME are Rovhult, Rovhult, Twopart, Hearts and Buraco or "
"the\n"
"numbers 0 - 3 (corresponding to the games in the above order).\n"
"\n"
msgstr ""
"Gültige Werte für SPIEL sind Rovhult, Røvhult, Twopart, Hearts und Buraco "
"oder\n"
"die Nummern 0 - 3 (entsprechend den Spielen in der vorigen Anordnung).\n"
"\n"
"Die INI-Datei kann die folgenden Einträge enthalten:\n"
"\n"

#: src/CardCol.cpp:1515
msgid "-warning: Invalid game type `%1'"
msgstr "-Warnung: Ungültiger Spieltyp '%1'"

#: src/CardCol.cpp:1521
msgid "-warning: No game specified! Ignoring option `g'\n"
msgstr "-Warnung: Kein Spiel angegeben! Ignoriere Option 'g'\n"

#: src/CardCol.cpp:1529
msgid "-warning: No directory specified! Ignoring option `d'\n"
msgstr "-Warnung: Kein Verzeichnis angegeben! Ignoriere Option 'd'\n"

#: src/CardCol.cpp:1537
msgid "-warning: No browser specified! Ignoring option `b'\n"
msgstr "-Warnung: Kein Browser angegeben! Ignoriere Option 'b'\n"

#: src/CardCol.cpp:1545
msgid "-warning: No file specified! Ignoring option `f'\n"
msgstr "-Warnung: Keine Datei angegeben! Ignoriere Option 'f'\n"

#: src/CardCol.cpp:1553
msgid "-warning: No port specified! Ignoring option `l'\n"
msgstr "-Warnung: Kein Port angegeben! Ignoriere Option 'l'\n"

#: src/CardCol.cpp:1568
msgid "-warning: No target specified! Ignoring option `c'\n"
msgstr "-Warnung: Kein Zielrechner angegeben! Ignoriere Option 'c'\n"

