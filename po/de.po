#: src/CardCol.cpp:1502
msgid ""
"Collection of cardgames\n"
"\n"
"Usage: "
msgstr ""
"Sammlung von Kartenspielen\n"
"\n"
"Aufruf: "

#: src/CardCol.cpp:1503
msgid ""
" [OPTIONS]\n"
"\n"
msgstr ""
" [OPTIONEN]\n"
"\n"

#: src/CardCol.cpp:1505
msgid "[GAME] Select game to start (default: Rovhult)\n"
msgstr "[SPIEL] Wähle Anfangsspiel (default: Røvhult)\n"

#: src/CardCol.cpp:1506
msgid "[FILE] Use file as INI file\n"
msgstr "[DATEI] Spezifizieren der INI-Datei\n"

#: src/CardCol.cpp:1507
msgid "[NAME] Browser to use to display the help\n"
msgstr "[PROGRAMM] Browser zum Anzeigen der Hilfe\n"

#: src/CardCol.cpp:1508
msgid "[DIR] Directory to search for help\n"
msgstr "[DIR] Verzeichnis, in dem die Hilfe gesucht wird\n"

#: src/CardCol.cpp:1510
msgid "[PORT] Awaits connections on port PORT\n"
msgstr "[PORT] Warte auf Verbindungen auf port PORT\n"

#: src/CardCol.cpp:1511
msgid "[SERVER[:PORT]] Connects to SERVER:PORT\n"
msgstr "[SERVER][:PORT] Verbinde zu SERVER:PORT\n"

#: src/CardCol.cpp:1514
msgid "[FILE] Saves game into FILE\n"
msgstr "[DATEI] Speichere Spiel in DATEI\n"

#: src/CardCol.cpp:1515
msgid "[FILE] Load game from FILE\n"
msgstr "[DATEI] Lade Spiel von DATEI\n"

#: src/CardCol.cpp:1517
msgid "Output version information and exit\n"
msgstr "Zeige Versionsinformation and beende\n"

#: src/CardCol.cpp:1518
msgid ""
"Displays this help and exit\n"
"\n"
msgstr ""
"Zeige diese Hilfe und beende\n"
"\n"

#: src/CardCol.cpp:1521
msgid ""
"Valid values for GAME are Rovhult, Rovhult, Twopart, Hearts and Buraco,\n"
"Machiavelli or the numbers 0 - 4 (corresponding to the games in the above "
"order).\n"
"\n"
msgstr ""
"Gültige Werte für SPIEL sind Rovhult, Røvhult, Twopart, Hearts, Buraco und\n"
"Machiavelli oder die Nummern 0 - 4 (entsprechend den Spielen in der vorigen\n"
"Anordnung).\n"
"\n"

#: src/CardCol.cpp:1523
msgid ""
"The INI file can have the following entries:\n"
"\n"
msgstr ""
"Die INI-Datei kann die folgenden Einträge enthalten:\n"
"\n"

#: src/CardCol.cpp:1554
msgid "-warning: Invalid game type `%1'"
msgstr "-Warnung: Ungültiger Spieltyp '%1'"

#: src/CardCol.cpp:1560
msgid "-warning: No game specified! Ignoring option `g'\n"
msgstr "-Warnung: Kein Spiel angegeben! Ignoriere Option 'g'\n"

#: src/CardCol.cpp:1568
msgid "-warning: No directory specified! Ignoring option `d'\n"
msgstr "-Warnung: Kein Verzeichnis angegeben! Ignoriere Option 'd'\n"

#: src/CardCol.cpp:1576
msgid "-warning: No browser specified! Ignoring option `b'\n"
msgstr "-Warnung: Kein Browser angegeben! Ignoriere Option 'b'\n"

#: src/CardCol.cpp:1584
msgid "-warning: No file specified! Ignoring option `f'\n"
msgstr "-Warnung: Keine Datei angegeben! Ignoriere Option 'f'\n"

#: src/CardCol.cpp:1593
msgid "-warning: No port specified! Ignoring option `l'\n"
msgstr "-Warnung: Kein Port angegeben! Ignoriere Option 'l'\n"

#: src/CardCol.cpp:1610
msgid "-warning: No target specified! Ignoring option `c'\n"
msgstr "-Warnung: Kein Zielrechner angegeben! Ignoriere Option 'c'\n"

#: src/CardCol.cpp:1625
msgid ""
"-warning: Option `%1' has already been specified!\n"
"Overwriting old setting\n"
msgstr ""
"-Warnung: Option '%1' bereits angegeben!\n"
"Überschreibe alte Einstellung\n"

#: src/CardCol.cpp:1635
msgid "-warning: No file specified! Ignoring option `%1'\n"
msgstr "-Warnung: Keine Datei angegeben! Ignoriere Option '%1'\n"

