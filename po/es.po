msgid "Output version information and exit\n"
msgstr "Informa de la versión y finaliza\n"

#: src/CardCol.cpp:1614
msgid ""
"Displays this help and exit\n"
"\n"
msgstr ""
"Muestra esta ayuda y finaliza\n"
"\n"

#: src/CardCol.cpp:1617
msgid ""
"Valid values for GAME are Rovhult, Rovhult, Twopart, Hearts, Buraco,\n"
"Machiavelli, SgtMayor or the numbers 0 - 5 (corresponding to the games in "
"the above order).\n"
"\n"
msgstr ""
"Valores validos por JUEGO son Rovhult, Røvhult, Hearts, Buraco, Machiavelli "
"y\n"
"SgtMayor o los números 0 - 4 (de acuerdo con el juego en el orden de "
"arriba).\n"
"\n"

