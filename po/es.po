msgid ""
" [OPTIONS]\n"
"\n"
msgstr ""
" [OPCIONES]\n"
"\n"

#: src/CardCol.cpp:1601
msgid "[GAME] Select game to start (default: Rovhult)\n"
msgstr "[JUEGO] Selecta juego para empezar (por defecto: Røvhult)\n"

#: src/CardCol.cpp:1602
msgid "[FILE] Use file as INI file\n"
msgstr "[FICHERO] Use fichero como archivo de initializar\n"

#: src/CardCol.cpp:1603
msgid "[NAME] Browser to use to display the help\n"
msgstr "[NOMBRE] Browser para mostrar la ayuda\n"

#: src/CardCol.cpp:1604
msgid "[DIR] Directory to search for help\n"
msgstr "[DIR] Directorio donde se busca la ayuda\n"

#: src/CardCol.cpp:1606
msgid "[PORT] Awaits connections on port PORT\n"
msgstr "[PUERTO] Espera a coneciones a puerto PUERTO\n"

#: src/CardCol.cpp:1607
msgid "[SERVER[:PORT]] Connects to SERVER:PORT\n"
msgstr "[SERVIDOR][:PUERTO] Conecta a SERVIDOR:PUERTO\n"

#: src/CardCol.cpp:1610
msgid "[FILE] Saves game into FILE\n"
msgstr "[FICHERO] Guarda juego en FICHERO\n"

#: src/CardCol.cpp:1611
msgid "[FILE] Load game from FILE\n"
msgstr "[FICHERO] Abre juego de FICHERO\n"

