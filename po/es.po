#: src/CardCol.cpp:859
msgid ""
"Collection of cardgames\n"
"\n"
"Usage: "
msgstr ""

#: src/CardCol.cpp:860
msgid ""
" [OPTIONS]\n"
"\n"
"  -g, --game ....... [GAME] Select game to start (default: Røvhult)\n"
"  -f, --file ....... [FILE] Use file as INI file\n"
"  -b, --browser .... [NAME] Browser to use to display the help\n"
"  -d, --help-dir ... [DIR] Directory to search for help\n"
"  -V, --version .... Output version information and exit\n"
"  -h, -?, --help ... Displays this help and exit\n"
"\n"
"Valid values for GAME are Rovhult, Røvhult, Twopart, Hearts and Burazno or "
"the\n"
"numbers 0 - 3 (corresponding to the games in the above order).\n"
"\n"
"The INI file can have the following entries:"
msgstr ""

