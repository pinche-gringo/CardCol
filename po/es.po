"Muestra esta ayuda y finaliza\n"
"\n"

#: src/CardCol.cpp:1484
msgid ""
"Valid values for GAME are Rovhult, Rovhult, Twopart, Hearts and Buraco,\n"
"Machiavelli or the numbers 0 - 4 (corresponding to the games in the above "
"order).\n"
"\n"
msgstr ""
"Valores validos por JUEGO son Rovhult, Røvhult, Hearts, Buraco y Machiavelli o\n"
"los números 0 - 4 (de acuerdo con el juego en el orden de arriba).\n"
"\n"

#: src/CardCol.cpp:1486
msgid ""
"The INI file can have the following entries:\n"
"\n"
msgstr ""
"El archivo de inicialicación puede tener las siguentes propiedades:\n"
"\n"

#: src/CardCol.cpp:1517
msgid "-warning: Invalid game type `%1'"
msgstr "-aviso: Tipo de juego '%1' invalido"

#: src/CardCol.cpp:1523
msgid "-warning: No game specified! Ignoring option `g'\n"
msgstr "-aviso: No juego especificado! Ignora opción 'g'\n"

#: src/CardCol.cpp:1531
msgid "-warning: No directory specified! Ignoring option `d'\n"
msgstr "-aviso: No directorio especificado! Ignora opción 'd'\n"

#: src/CardCol.cpp:1539
msgid "-warning: No browser specified! Ignoring option `b'\n"
msgstr "-aviso: No browser especificado! Ignora opción 'b'\n"

#: src/CardCol.cpp:1547
msgid "-warning: No file specified! Ignoring option `f'\n"
msgstr "-aviso: No fichero especificado! Ignora opción 'f'\n"

#: src/CardCol.cpp:1555
msgid "-warning: No port specified! Ignoring option `l'\n"
msgstr "-aviso: No puerto especificado! Ignora opción 'l'\n"

#: src/CardCol.cpp:1570
msgid "-warning: No target specified! Ignoring option `c'\n"
msgstr "-aviso: No destincación especificado! Ignora opción 'c'\n"

#: src/CardCol.cpp:1584
msgid ""
"-warning: Option `%1' has already been specified!\n"
"Overwriting old setting\n"
