#: src/CardCol.cpp:1457
msgid ""
"Collection of cardgames\n"
"\n"
"Usage: "
msgstr ""
"Colleción de juegos de cartas\n"
"\n"
"Modo de empleo: "

#: src/CardCol.cpp:1458
msgid ""
" [OPTIONS]\n"
"\n"
msgstr ""
"[OPCIONES]\n"
"\n"

#: src/CardCol.cpp:1460
msgid "[GAME] Select game to start (default: Rovhult)\n"
msgstr "[JUEGO] Selecta juego para empezar (por defecto: Røvhult)\n"

#: src/CardCol.cpp:1461
msgid "[FILE] Use file as INI file\n"
msgstr "[FICHERO] Use fichero como archivo de initializar\n"

#: src/CardCol.cpp:1462
msgid "[NAME] Browser to use to display the help\n"
msgstr "[NOMBRE] Browser para mostrar la ayuda\n"

#: src/CardCol.cpp:1463
msgid "[DIR] Directory to search for help\n"
msgstr "[DIR] Directorio donde se busca la ayuda\n"

#: src/CardCol.cpp:1464
msgid "[PORT] Awaits connections on port PORT\n"
msgstr "[PUERTO] Espera a coneciones a puerto PUERTO\n"

#: src/CardCol.cpp:1465
msgid "[SERVER[:PORT]] Connects to SERVER:PORT\n"
msgstr "[SERVIDOR][:PUERTO] Conecta a SERVIDOR:PUERTO\n"

#: src/CardCol.cpp:1466
msgid "Output version information and exit\n"
msgstr "Informa de la versión y finaliza\n"

#: src/CardCol.cpp:1467
msgid ""
"Displays this help and exit\n"
"\n"
msgstr ""
"Muestra esta ayuda y finaliza\n"
"\n"

#: src/CardCol.cpp:1470
msgid ""
"Valid values for GAME are Rovhult, Rovhult, Twopart, Hearts and Buraco or "
"the\n"
"numbers 0 - 3 (corresponding to the games in the above order).\n"
"\n"
msgstr ""
"Valores validos por JUEGO son Rovhult, Røvhult, Hearts y Buraco o los\n"
"números 0 - 3 (de acuerdo con el juego en el orden de arriba).\n"
"\n"

