"\n"
"Modo de empleo: "

#: src/CardCol.cpp:1496
msgid ""
" [OPTIONS]\n"
"\n"
msgstr ""
" [OPCIONES]\n"
"\n"

#: src/CardCol.cpp:1498
msgid "[GAME] Select game to start (default: Rovhult)\n"
msgstr "[JUEGO] Selecta juego para empezar (por defecto: Røvhult)\n"

#: src/CardCol.cpp:1499
msgid "[FILE] Use file as INI file\n"
msgstr "[FICHERO] Use fichero como archivo de initializar\n"

#: src/CardCol.cpp:1500
msgid "[NAME] Browser to use to display the help\n"
msgstr "[NOMBRE] Browser para mostrar la ayuda\n"

#: src/CardCol.cpp:1501
msgid "[DIR] Directory to search for help\n"
msgstr "[DIR] Directorio donde se busca la ayuda\n"

#: src/CardCol.cpp:1503
msgid "[PORT] Awaits connections on port PORT\n"
msgstr "[PUERTO] Espera a coneciones a puerto PUERTO\n"

#: src/CardCol.cpp:1504
msgid "[SERVER[:PORT]] Connects to SERVER:PORT\n"
msgstr "[SERVIDOR][:PUERTO] Conecta a SERVIDOR:PUERTO\n"

#: src/CardCol.cpp:1507
msgid "[FILE] Saves game into FILE\n"
msgstr "[FICHERO] Guarda juego en FICHERO\n"

#: src/CardCol.cpp:1508
msgid "[FILE] Load game from FILE\n"
msgstr "[FICHERO] Abre juego de FICHERO\n"

#: src/CardCol.cpp:1510
msgid "Output version information and exit\n"
msgstr "Informa de la versión y finaliza\n"

#: src/CardCol.cpp:1511
msgid ""
"Displays this help and exit\n"
"\n"
msgstr ""
"Muestra esta ayuda y finaliza\n"
"\n"

#: src/CardCol.cpp:1514
msgid ""
"Valid values for GAME are Rovhult, Rovhult, Twopart, Hearts and Buraco,\n"
"Machiavelli or the numbers 0 - 4 (corresponding to the games in the above "
"order).\n"
"\n"
msgstr ""
"Valores validos por JUEGO son Rovhult, Røvhult, Hearts, Buraco y Machiavelli "
"o\n"
"los números 0 - 4 (de acuerdo con el juego en el orden de arriba).\n"
"\n"

#: src/CardCol.cpp:1516
msgid ""
"The INI file can have the following entries:\n"
"\n"
msgstr ""
"El archivo de inicialicación puede tener las siguentes propiedades:\n"
"\n"

#: src/CardCol.cpp:1547
msgid "-warning: Invalid game type `%1'"
msgstr "-aviso: Tipo de juego '%1' invalido"

#: src/CardCol.cpp:1553
msgid "-warning: No game specified! Ignoring option `g'\n"
msgstr "-aviso: No juego especificado! Ignora opción 'g'\n"

#: src/CardCol.cpp:1561
msgid "-warning: No directory specified! Ignoring option `d'\n"
msgstr "-aviso: No directorio especificado! Ignora opción 'd'\n"

#: src/CardCol.cpp:1569
msgid "-warning: No browser specified! Ignoring option `b'\n"
msgstr "-aviso: No browser especificado! Ignora opción 'b'\n"

#: src/CardCol.cpp:1577
msgid "-warning: No file specified! Ignoring option `f'\n"
msgstr "-aviso: No fichero especificado! Ignora opción 'f'\n"

#: src/CardCol.cpp:1586
msgid "-warning: No port specified! Ignoring option `l'\n"
msgstr "-aviso: No puerto especificado! Ignora opción 'l'\n"

#: src/CardCol.cpp:1603
msgid "-warning: No target specified! Ignoring option `c'\n"
msgstr "-aviso: No destincación especificado! Ignora opción 'c'\n"

#: src/CardCol.cpp:1618
msgid ""
"-warning: Option `%1' has already been specified!\n"
"Overwriting old setting\n"
msgstr ""
"-avios: Opción '%1' ya especificado!\n"
"Sobreescribo propiedad antigua\n"

#: src/CardCol.cpp:1628
msgid "-warning: No file specified! Ignoring option `%1'\n"
msgstr "-aviso: No fichero especificado! Ignora opción '%1'\n"

