    <title>Sgt. Mayor - Haz tus bazas o te vas a arrepentir</title>
    <meta name="description" content="Documentaci&oacute;n del juego de cartas Sgt. Mayor">
    <meta name="keywords" content="documentacion, documentaci&oacute;n, docu, Sgt. Mayor; game, juego, card, cardgame, carta, juego de cartas">

