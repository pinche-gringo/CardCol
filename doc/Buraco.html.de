  <head>
    <title>Buraco - Canasta mit lateinamerikanischen Einschlag</title>
    <meta name="description" content="Documentation of the Buraco cardgame">
    <meta name="keywords" content="Documentation, Docu, Buraco, game, card, cardgame">

    <meta name="DC.Creator" content="Markus Schwab">
